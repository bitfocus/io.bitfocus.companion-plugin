{
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c --nocache -w --watch.onEnd=\"streamdeck restart io.bitfocus.companion-plugin\"",
		"link": "streamdeck link io.bitfocus.companion-plugin.sdPlugin",
		"pack": "streamdeck pack io.bitfocus.companion-plugin.sdPlugin",
		"restart": "streamdeck restart io.bitfocus.companion-plugin",
		"format": "prettier -w .",
		"lint": "prettier --check .",
		"check-types": "tsc --noEmit",
		"vendor": "node scripts/download-vendor.mjs"
	},
	"type": "module",
	"devDependencies": {
		"@elgato/cli": "^1.10.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-image": "^3.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node20": "^20.1.10",
		"@types/node": "^24.19.2",
		"@types/pngjs": "^6.0.5",
		"@types/ws": "^8.18.2",
		"prettier": "^3.9.10",
		"rollup": "^4.64.5",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@companion-app/satellite-protocol": "^0.1.0",
		"@elgato/streamdeck": "^2.1.2",
		"pngjs": "^7.0.0",
		"ws": "^8.22.0"
	},
	"packageManager": "yarn@4.14.0"
}
